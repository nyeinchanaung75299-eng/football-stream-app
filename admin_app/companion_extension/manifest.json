{
  "manifest_version": 3,
  "name": "NCA Admin Web Media Capture",
  "version": "1.0.1",
  "description": "Show HLS/DASH requests from a source tab in the NCA Admin Web picker.",
  "permissions": ["webRequest", "tabs", "storage"],
  "host_permissions": ["https://*/*"],
  "background": {"service_worker": "worker.js"},
  "content_scripts": [
    {
      "matches": ["https://nyeinchanaung75299-eng.github.io/football-stream-app/admin/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
