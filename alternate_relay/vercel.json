{
  "version": 2,
  "functions": {
    "api/relay.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/relay?path=health" },
    { "source": "/matches", "destination": "/api/relay?path=matches" },
    { "source": "/matches/:matchId/streams", "destination": "/api/relay?path=matches/:matchId/streams" },
    { "source": "/admin/functions/:name", "destination": "/api/relay?path=admin/functions/:name" },
    { "source": "/p/:rest*", "destination": "/api/relay?path=p/:rest*" }
  ]
}
